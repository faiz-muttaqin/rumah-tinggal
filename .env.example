# Copy to .env locally. Never put real credentials in this example.
HOST=127.0.0.1
PORT=3100
# Isi origin persis pada .env; kosong hanya memakai Host loopback lokal.
APP_ORIGIN=
DATA_DIR=./data

# Firebase web configuration is public client configuration, not a private key.
# Reuse values from the reference project's Firebase console when implementing auth.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Define a separate authorization policy before exposing private application data.
ALLOWED_EMAILS=
