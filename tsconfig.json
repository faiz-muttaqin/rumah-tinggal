{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node", "geojson", "vite/client"]
  },
  "include": [
    "scripts/**/*.ts",
    "src/**/*.ts",
    "server/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
