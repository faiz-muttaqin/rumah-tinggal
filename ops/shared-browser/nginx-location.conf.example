# Include inside an existing HTTPS server block.
# Backend is intentionally loopback only; never proxy ports 5900 or 9222.
location = /shared-browser {
    return 302 /shared-browser/vnc.html?autoconnect=1&resize=scale&path=shared-browser/websockify;
}
location = /shared-browser/ {
    return 302 /shared-browser/vnc.html?autoconnect=1&resize=scale&path=shared-browser/websockify;
}
location ^~ /shared-browser/ {
    auth_basic "Shared browser";
    auth_basic_user_file /etc/rumah-shared-browser/htpasswd;
    proxy_pass http://127.0.0.1:6080/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    access_log off;
}
