# TEMPLATE TIDAK AKTIF. Aplikasi produksi menggunakan loopback port 3100.
# Ganti domain, lokasi rilis, serta jalur sertifikat sebelum dipasang.
# Provision sertifikat terpisah; jangan simpan private key di repository.
# nginx -t harus lulus sebelum konfigurasi final di-reload.

server {
    listen 80;
    server_name rumah.example.com;

    # Hanya untuk ACME HTTP-01 dengan webroot, jika metode ini dipilih.
    # Direktori ini berisi file publik, bukan source repository atau data.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/rumah-tinggal/public;
        try_files $uri =404;
    }

    location / {
        return 301 https://rumah.example.com$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name rumah.example.com;

    # Placeholder: file sertifikat ini belum disiapkan oleh proyek.
    ssl_certificate /etc/letsencrypt/live/rumah.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rumah.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/rumah-tinggal/public;
    server_tokens off;
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Hanya dua berkas peta publik; seluruh file data privat tetap ditolak.
    location = /data/regions.geojson {
        proxy_pass http://127.0.0.1:3100;
    }
    location = /data/transit.geojson {
        proxy_pass http://127.0.0.1:3100;
    }

    # Dotfiles mencakup .env, .git, dan folder kredensial tersembunyi.
    location ~ (^|/)\. {
        return 404;
    }

    location ~* ^/(?:data|local|storage|backups?|secrets?|node_modules)(?:/|$) {
        return 404;
    }

    location ~* \.(?:pem|key|p12|pfx|sqlite3?|db|sql|bak|log)$ {
        return 404;
    }

    # OPSIONAL: Firebase redirect helper pada domain aplikasi.
    # JANGAN aktifkan sebelum mengganti REPLACE_FIREBASE_PROJECT_HOST,
    # mengatur authDomain, Authorized Domains, dan OAuth redirect URI.
    # Host tujuan harus host Firebase project resmi, tanpa skema/path.
    # Proxy transparan diperlukan; jangan ganti dengan redirect HTTP 302.
    # location /__/auth/ {
    #     proxy_pass https://REPLACE_FIREBASE_PROJECT_HOST;
    #     proxy_ssl_server_name on;
    #     proxy_ssl_name REPLACE_FIREBASE_PROJECT_HOST;
    #     proxy_set_header Host REPLACE_FIREBASE_PROJECT_HOST;
    #     proxy_ssl_verify on;
    #     proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    #     proxy_cache off;
    #     add_header Cache-Control "no-store" always;
    # }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
